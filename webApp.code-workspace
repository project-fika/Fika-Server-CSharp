{
    "folders": [
	{
            "name": "Frontend (React Mantine)",
            "path": "frontend"
        },
        {
            "name": "Backend (.NET)",
            "path": "FikaWebApp"
        },
        {
            "name": "Shared (.NET)",
            "path": "FikaShared"
        }
    ],
    "settings": {
        "files.exclude": {
            "**/bin": true,
            "**/obj": true,
            "**/node_modules": true
        },
        "js/ts.tsdk.path": "frontend/node_modules/typescript/lib"
    },
    "launch": {
        "version": "0.2.0",
        "configurations": [
            {
                "name": ".NET Core Launch (FikaWebApp)",
                "type": "coreclr",
                "request": "launch",
                "preLaunchTask": "build",
                "program": "${workspaceFolder}/bin/Debug/net10.0/FikaWebApp.dll",
                "args": [],
                "cwd": "${workspaceFolder}",
                "stopAtEntry": false,
                "serverReadyAction": {
                    "action": "openExternally",
                    "pattern": "\\bnow listening on:\\s+(https?://\\S+)"
                },
                "env": {
                    "ASPNETCORE_ENVIRONMENT": "Development"
                }
            }
        ]
    },
    "tasks": {
        "version": "2.0.0",
        "tasks": [
            {
                "label": "build",
                "command": "dotnet",
                "type": "process",
                "args": [
                    "build",
                    "${workspaceFolder}/FikaWebApp.csproj",
                    "/property:GenerateFullPaths=true",
                    "/consoleloggerparameters:NoSummary"
                ],
                "problemMatcher": "$msCompile"
            }
        ]
    }
}